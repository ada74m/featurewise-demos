<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Demos.Common\Demos.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Featurewise.Hosting, as a package, or from a local checkout when FeaturewiseSource is set; see Directory.Build.props. -->
        <PackageReference Include="Featurewise.Hosting" Version="$(FeaturewiseVersion)" Condition="'$(FeaturewiseSource)' == ''" />
        <ProjectReference Include="$(FeaturewiseDirectory)Featurewise.Hosting/Featurewise.Hosting.csproj" Condition="'$(FeaturewiseSource)' != ''" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Amazon.Lambda.APIGatewayEvents" Version="3.0.1" />
        <PackageReference Include="Amazon.Lambda.Core" Version="3.4.0" />
        <PackageReference Include="Amazon.Lambda.DynamoDBEvents" Version="4.0.0" />
    </ItemGroup>

</Project>
